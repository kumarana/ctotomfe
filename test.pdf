% --- SLIDE 2: THE PROBLEM ---
\begin{frame}{The Problem: Context Overload}
    \centering
    
    \begin{tikzpicture}[node distance=1cm]
        % Funnel Visualization
        \node[cylinder, shape border rotate=90, draw=techblue, fill=techblue!10, aspect=0.25, minimum height=3cm, minimum width=2.5cm] (context) {};
        
        \node[above=0.2cm of context, font=\bfseries] {The Context Window};
        
        % Stuffing it
        \node[above=1cm of context, align=center] (files) {
            \textbf{Entire Codebase} \\
            (GBs of Data)
        };
        \draw[->, ultra thick, techpurple] (files) -- (context.top);
        
        % Output
        \node[below=0.5cm of context, draw=red, thick, rounded corners, fill=red!10, align=center] (result) {
            \textbf{HIGH COST} (\$\$\$)\\
            \textbf{SLOW LATENCY}\\
            \textbf{CONFUSION}
        };
        \draw[->, thick, dashed] (context.bottom) -- (result);
    \end{tikzpicture}
    
    \vspace{0.5cm}
    \begin{itemize}
        \item \textbf{Wasted Tokens:} Paying for irrelevant code.
        \item \textbf{Model Confusion:} "Noise" reduces accuracy.
    \end{itemize}
    
    \vspace{0.5cm}
    \textit{"Irrelevant context is just expensive noise."}
\end{frame}

% --- SLIDE 3: THE SOLUTION ---
\begin{frame}{The Solution: Progressive Disclosure}
    
    \begin{columns}
        \column{0.5\textwidth}
            \centering
            \begin{tikzpicture}
                % Maze concept
                \draw[thick, techblue] (0,0) grid (3,3);
                \fill[techpurple] (0.5, 0.5) circle (0.2) node[right=5pt, black] {Agent};
                % Spotlight effect
                \draw[yellow, opacity=0.5, line width=5pt] (0.5, 0.5) -- (1.5, 0.5) -- (1.5, 1.5);
                \node at (1.5, 2.5) [font=\tiny] {Hidden};
            \end{tikzpicture}
            
        \column{0.5\textwidth}
            \textbf{The Strategy:}
            \begin{itemize}
                \item Don't dump the whole repo.
                \item Let the AI \textbf{explore} step-by-step.
                \item Mimic a Senior Engineer: Look at file structure $\to$ Search $\to$ Read specific file.
            \end{itemize}
    \end{columns}
    
    \vspace{1cm}
    \centering
    \large \textbf{Just-in-Time Information Retrieval}
\end{frame}

% --- SLIDE 4: THE MECHANISM ---
\begin{frame}{How It Works: Bash \& MCP}
    \centering
    \textit{Moving from custom RAG to Standard Bash}
    \vspace{0.5cm}
    
    \begin{tikzpicture}[auto, node distance=1.5cm,
        block/.style={rectangle, draw=techblue, fill=white, text width=2.5cm, align=center, rounded corners, minimum height=1.2cm},
        arrow/.style={->, >=stealth, thick, techpurple}]
        
        \node[block, fill=techblue!10] (ai) {\textbf{AI Agent}};
        \node[block, right=of ai] (tools) {\textbf{Bash Tools}\\ \texttt{ls}, \texttt{grep}, \texttt{cat}};
        \node[block, right=of tools] (fs) {\textbf{File System}};
        
        \draw[arrow] (ai) -- node[above, font=\tiny] {Calls Tool} (tools);
        \draw[arrow] (tools) -- node[above, font=\tiny] {Reads} (fs);
        \draw[arrow, bend left=45] (fs) to node[below, font=\tiny] {Returns Data} (ai);
        
    \end{tikzpicture}
    
    \vspace{1cm}
    \begin{itemize}
        \item \textbf{Predictable:} Uses standard command line tools.
        \item \textbf{Efficient:} Reads only what is strictly necessary.
        \item \textbf{Scalable:} Protocols like \textbf{MCP} standardize this.
    \end{itemize}
\end{frame}

